# Public placeholders for this disposable local Compose database only.
# Never use these values for hosted services or put real credentials here.
DATABASE_URL="postgresql://encore_local:encore_local_only@127.0.0.1:54329/encore_local?schema=public"

# After database setup, pnpm run auth:init appends BETTER_AUTH_URL,
# BETTER_AUTH_SECRET, DEMO_OWNER_PASSWORD, and DEMO_STAFF_PASSWORD to ignored .env.
# Secrets/passwords are generated locally; never copy them into tracked files.
# Use pnpm run auth:seed, then pnpm run dev for the synthetic authentication demo.
# All auth/demo endpoints are disabled in production, including pnpm run start.
# Optional existing-synthetic-account verification/recovery: add ENCORE_AUTH_CAPTURE=1
# to ignored .env. Captured secret links stay in ignored .local-auth-mail/; no email is sent.
