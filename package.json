{
  "name": "encore",
  "version": "0.0.0",
  "private": true,
  "description": "Encore application foundation and contributor harness",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "12.18.0"
  },
  "scripts": {
    "doctor": "node scripts/doctor.ts",
    "check": "node scripts/check.ts",
    "compiler:version": "tsc --version",
    "context:check": "node scripts/context-check.ts",
    "context:test": "node --test scripts/context-check.test.ts",
    "typecheck": "node scripts/typecheck.ts",
    "cloud:setup": "node scripts/cloud-setup.ts",
    "dev": "next dev",
    "start": "next start",
    "build": "node scripts/build.ts",
    "lint": "biome lint .",
    "test": "vitest run",
    "db:init": "node scripts/db.ts init",
    "db:up": "node scripts/db.ts up",
    "db:down": "node scripts/db.ts down",
    "db:status": "node scripts/db.ts status",
    "db:migrate": "node scripts/db.ts migrate",
    "db:seed": "node scripts/db.ts seed",
    "db:reset": "node scripts/db.ts reset",
    "db:verify": "node scripts/db.ts verify",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "ledger:verify": "node tests/ledger-schema.integration.ts",
    "ledger:service:verify": "node tests/ledger-service.integration.ts",
    "ledger:http:verify": "node tests/ledger-http.integration.ts",
    "venue:access:verify": "node tests/venue-access.integration.ts",
    "venue:http:verify": "node tests/venue-access-http.integration.ts",
    "auth:init": "node scripts/auth-init.ts",
    "auth:seed": "node scripts/auth-seed.ts",
    "auth:verify": "node tests/auth.integration.ts",
    "production:verify": "node tests/production.integration.ts",
    "browser:verify": "node scripts/browser-verify.ts",
    "door:browser:verify": "node tests/door-live.browser.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.20",
    "next": "16.4.5",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "bun-types": "1.4.4",
    "playwright": "1.65.0",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  },
  "type": "module",
  "packageManager": "pnpm@12.18.0"
}
