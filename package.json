{
  "name": "encore",
  "version": "0.0.0",
  "private": true,
  "description": "Encore application foundation and contributor harness",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "12.18.0"
  },
  "scripts": {
    "doctor": "node scripts/doctor.ts",
    "check": "node scripts/check.ts",
    "compiler:version": "tsc --version",
    "context:check": "node scripts/context-check.ts",
    "context:test": "node --test scripts/context-check.test.ts",
    "typecheck": "node scripts/typecheck.ts",
    "cloud:setup": "node scripts/cloud-setup.ts",
    "dev": "next dev",
    "start": "next start",
    "build": "next build",
    "lint": "biome lint .",
    "test": "vitest run"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  },
  "type": "module",
  "packageManager": "pnpm@12.18.0"
}
